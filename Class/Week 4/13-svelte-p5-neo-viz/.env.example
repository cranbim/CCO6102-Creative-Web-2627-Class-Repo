# Get a free key (instant, no credit card) at https://api.nasa.gov
# Copy this file to .env and paste your key in below.
#
# If you don't do this, the server falls back to NASA's public DEMO_KEY
# automatically — it works out of the box, just with a much lower rate
# limit (30 requests/hour vs 1,000/hour for a personal key).
NASA_API_KEY=your_key_here
