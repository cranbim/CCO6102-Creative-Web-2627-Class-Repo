# Copy this file to a new file called .env  (same folder, name starts with a dot).
# .env is private: it is listed in .gitignore, so it never gets uploaded to GitHub.
#
# DEMO_KEY is NASA's shared practice key. It works straight away, but it is
# limited to 30 requests per hour for everyone using it, so it will run out
# in a busy class.
#
# For class, get your own free key (instant, no credit card) at https://api.nasa.gov
# and replace DEMO_KEY below with it.
NASA_API_KEY=DEMO_KEY
